@model WebAdminConsole.Models.Runner

@{
    ViewData["Title"] = "Edit Runner";
}

<h1>Edit</h1>

<h4>Runner</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="EditRunner">
            @if (ViewData["Error"] != null)
            {
                <h6 class="text-danger">@ViewData["Error"]</h6>
            }
            @if (ViewData["TeamName"] != null)
            {
                <h6 class="control-label">@ViewData["TeamName"]</h6>
            }
            <input type="hidden" asp-for="TeamId" value=@ViewData["TeamId"] />
            <input type="hidden" asp-for="RunnerId" />
            <div class="form-group">
                <label asp-for="BibNumberId" class="control-label"></label>
                <select asp-for="BibNumberId" class="form-control" asp-items="ViewBag.BibNumberId"></select>
                <span asp-validation-for="BibNumberId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="First" class="control-label"></label>
                <input asp-for="First" class="form-control" />
                <span asp-validation-for="First" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Last" class="control-label"></label>
                <input asp-for="Last" class="form-control" />
                <span asp-validation-for="Last" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CategoryId" class="control-label"></label>
                <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="card border-secondary mt-3 mb-3">
                <div class="card-header bg-secondary text-white">
                    Early Starters Only
                </div>

                <div class="card-body">

                    <div class="form-group mb-3">
                        <label asp-for="Saturday" class="control-label"></label>
                        <input asp-for="Saturday" class="form-control" />
                        <span asp-validation-for="Saturday" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Sunday" class="control-label"></label>
                        <input asp-for="Sunday" class="form-control" />
                        <span asp-validation-for="Sunday" class="text-danger"></span>
                    </div>

                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="ListRunners" asp-route-id="@ViewData["TeamId"]">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
